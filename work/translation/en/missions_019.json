    "numbers_checked": "all seconds, percentages, counts, mission numbers and branch letters match",
    "defects_fixed": [
      "3057/240 obstruction -> interference areas (radar-interference zones per the mission guide)",
      "3055/220 Operation: Seize Ruins -> Ruins Capture Operation (same base-capture verb as its secret goal)",
      "3055/170 and 452 Break -> Breach the Defense Net",
      "3057/110 making the Gekko detour -> the Gekko having to detour (it detours on its own if the player is slow)"
    ],
    "kept_as_intentional": [
      "Sweep for mop-up missions: Mop Up and Eliminate exceed the 290-unit selector",
      "Probe for mission 01: Investigate exceeds the selector",
      "Stop covers both shutting down the Baldora Drive and halting Axis; Shut Down does not fit",
      "Branch missions use one space after the number for width",
      "Tresor Institute shortens the glossary name Tresor Research Institute for width"
    ],
    "uncertainties": [
      "Baldora Drive and Jill Bardona come from the same kana and are both provisional; needs one corpus-wide decision",
      "Infinite Mobile Cannon and Kleid have no official English spelling",
      "3055/460 could not be tied to a mission or mode; Subdue judged on wording alone",
      "09B Coralian Contact is a noun phrase while 24 Contact D.O.M.E. is imperative; both accurate",
      "17B Repel Pursuit Force 2 has no part 1 in English or in the source",
      "warships covers any capital ship"
    ],
    "post_review_compression": [
      "3057/150, 3057/170 and 3057/320 were abbreviated to 55 characters or fewer so no text allocation grows (a goal widget sized for about 30 Japanese characters most likely has the bounded 56-58 character allocation); every number and both conditions are kept"
    ]
  },
